{
	"name": "ml-learning-app-root",
	"version": "0.1.0",
	"private": true,
	"packageManager": "pnpm@10.28.0",
	"scripts": {
		"dev": "pnpm --filter @ml/web dev",
		"build": "pnpm --filter @ml/web build",
		"deploy": "pnpm --filter @ml/web deploy",
		"cf-typegen": "pnpm --filter @ml/web cf-typegen",
		"content:build": "tsx scripts/build-content.ts",
		"content:upload": "tsx scripts/upload-to-r2.ts",
		"content:upload:local": "tsx scripts/upload-to-r2.ts --local",
		"content:deploy": "pnpm content:build && pnpm content:upload"
	},
	"devDependencies": {
		"@mdx-js/mdx": "^3.1.0",
		"@shikijs/rehype": "^2.0.0",
		"@types/node": "^20.0.0",
		"execa": "^9.5.2",
		"fast-glob": "^3.3.3",
		"gray-matter": "^4.0.3",
		"rehype-katex": "^7.0.1",
		"rehype-stringify": "^10.0.1",
		"remark-math": "^6.0.0",
		"remark-mdx": "^3.1.0",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.1",
		"shiki": "^2.0.0",
		"tsx": "^4.19.2",
		"typescript": "^5.7.4",
		"unified": "^11.0.5",
		"unist-util-visit": "^5.1.0"
	},
	"dependencies": {
		"katex": "^0.16.46"
	}
}